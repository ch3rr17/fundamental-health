# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Google OAuth client from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required outside Vercel (e.g. local dev, Netlify, Cloudflare Pages)
AUTH_TRUST_HOST=true

# Comma-separated allowlist — only these Google accounts can sign in
AUTH_ALLOWED_EMAILS=

DATABASE_URL=******aws-0-region.pooler.supabase.com:5432/postgres
ANTHROPIC_API_KEY=sk-ant-...
KLAVIYO_API_KEY=pk_...
KLAVIYO_LIST_COMMUNITY_DONORS=your_list_id
KLAVIYO_LIST_NONPROFIT_MARKETING=your_list_id
KLAVIYO_LIST_BOARD_PROSPECTS=your_list_id
KLAVIYO_LIST_FINANCIAL_CRA=your_list_id
KLAVIYO_LIST_DAF_GIVING_CIRCLES=your_list_id

