# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Google OAuth client from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required outside Vercel (e.g. local dev, Netlify, Cloudflare Pages)
AUTH_TRUST_HOST=true

# Comma-separated allowlist — only these Google accounts can sign in
AUTH_ALLOWED_EMAILS=
